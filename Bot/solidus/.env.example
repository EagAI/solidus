# Privaloma tik DISCORD_TOKEN. Panelės prisijungimui dar reikia CLIENT_ID + CLIENT_SECRET.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Svetainės adresas. Discord Developer Portal → OAuth2 → Redirects turi būti:
#   <PANEL_URL>/api/auth/callback
# Lokaliai: http://localhost:5173   Produkcijoje: https://solidus.bot
PANEL_URL=http://localhost:5173
# 127.0.0.1 lokaliai; 0.0.0.0 kai svetainės nginx kreipiasi iš kito konteinerio
PANEL_API_HOST=127.0.0.1
PANEL_API_PORT=3847

# Neprivaloma: "namų" serveris senoms vieno serverio funkcijoms (verify, logai,
# YouTube, voice hub...). Tuščia = tos funkcijos išjungtos, botas vis tiek veikia.
GUILD_ID=

# Verify — prisijungus: Narys, patvirtinus mygtuku: Patvirtintas
VERIFY_CHANNEL_ID=
NARYS_ROLE_ID=
PATVIRTINTAS_ROLE_ID=
# Optional — jei tuščia, naudojamas VERIFY_CHANNEL_ID
WELCOME_CHANNEL_ID=

# YouTube RSS — kanalo UC id (About → Share channel). Test: /feeds/videos.xml?channel_id=UC…
YOUTUBE_CHANNEL_ID=UCIrljR3W5usL5wdpumwEugA
YOUTUBE_ANNOUNCE_CHANNEL_ID=
YOUTUBE_POLL_MS=120000

# Anti-invite moderation
ADMIN_ACTIONS_CHANNEL_ID=
LOGS_CHANNEL_ID=
MOD_ROLE_IDS=
INVITE_TIMEOUT_MS=86400000

# Antiscam OCR (image attachments)
SCAM_SCAN_ENABLED=true
SCAM_SCORE_THRESHOLD=4
SCAM_TIMEOUT_MS=86400000
SCAM_ALERT_COOLDOWN_MS=120000
# Optional: comma-separated channel IDs to scan ONLY those channels (empty = all)
SCAM_SCAN_CHANNEL_IDS=

# Join-to-create voice
VOICE_ENABLED=true
# Optional: category where hub + temp channels are created
VOICE_CATEGORY_ID=

# XP / lygiai
XP_PER_MESSAGE=15
XP_COOLDOWN_MS=5000
# /parukom mygtuko XP (viešai neminima)
RUKALIAI_GIVEN_XP=35
# @rukaliai rolė prieš embed
RUKALIAI_ROLE_ID=1548120206466093188
# Level-up pranešimai (5, 10, 15 …) — optional, kitaip WELCOME_CHANNEL_ID
LEVEL_UP_CHANNEL_ID=
# Giveaway skelbimai
GIVEAWAY_CHANNEL_ID=
# Tik nuotraukų attachment'ai (be teksto) — kableliais atskirti kanalų ID
MEDIA_CHANNEL_IDS=
# Lygio rolės: true = kaupia visas, false = tik aukščiausia (numatyta)
LEVEL_ROLES_STACK=false
